generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// The shared, cross-user record for a piece of media (movie, game, etc.).
/// All per-user state — status, personal rating, pairwise score, favorite,
/// archived — lives on `UserMedia`. The remaining `computedConsensusScore`
/// is intentionally cross-user: it aggregates everyone's signal.
model MediaItem {
  id                     String    @id @default(cuid())
  title                  String
  originalTitle          String?
  mediaType              MediaType
  description            String?
  releaseDate            DateTime?
  posterUrl              String?
  externalUrl            String?
  metadataJson           String?
  platformsJson          String?
  computedConsensusScore Float?
  consensusConfidence    Float     @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  genres          MediaGenre[]
  tags            MediaTag[]
  credits         MediaCredit[]
  comparisonsWon  PairwiseComparison[] @relation("Winner")
  comparisonsLost PairwiseComparison[] @relation("Loser")
  listItems       ListItem[]
  notes           Note[]
  externalRatings ExternalRating[]
  userMedia       UserMedia[]
  editSuggestions MediaEditSuggestion[]
  relationsFrom   MediaRelation[]      @relation("RelationFrom")
  relationsTo     MediaRelation[]      @relation("RelationTo")
  releaseEvents   MediaReleaseEvent[]

  @@unique([title, mediaType])
  @@index([mediaType])
  @@index([computedConsensusScore])
}

/// Directed link between two *separate* `MediaItem`s — used when each side is
/// its own scoring entity (remakes, sequels, adaptations, spin-offs). Same-
/// entity re-releases (remasters/ports) are NOT relations; they live in
/// `MediaReleaseEvent`. Each `kind` renders a forward label on the `from` side
/// and an inverse label on the `to` side (see `lib/media-relations.ts`); for
/// symmetric kinds the two labels match. Sequel/prequel are a single `FOLLOWS`
/// edge ("from follows to" = "from is a sequel of to"), linking only directly
/// adjacent entries — the chain orders a whole series without an N² web.
model MediaRelation {
  id        String       @id @default(cuid())
  fromId    String
  toId      String
  kind      RelationKind
  createdAt DateTime     @default(now())

  from MediaItem @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   MediaItem @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, kind])
  @@index([fromId])
  @@index([toId])
}

/// An additional dated release of an existing `MediaItem` — remaster, port,
/// re-release, or named DLC. The item's own `releaseDate` stays the *first*
/// release (the scoring anchor); these events carry the later dates. Future
/// events surface on the Upcoming calendar alongside brand-new items; the full
/// list (past + future) is the item's re-release history on the detail page.
/// `title` holds this release's distinct name ("Tales of Graces f Remastered",
/// "Ascension"), falling back to the item title when null.
model MediaReleaseEvent {
  id        String      @id @default(cuid())
  mediaId   String
  date      DateTime
  kind      ReleaseKind
  title     String?
  createdAt DateTime    @default(now())

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([date])
}

/// Per-user state for a `MediaItem`. One row per `(userId, mediaId)` — created
/// lazily the first time a user interacts with the item (rate / status / etc.).
/// Items the user has never touched simply have no row here.
model UserMedia {
  id                      String      @id @default(cuid())
  userId                  String
  mediaId                 String
  status                  MediaStatus @default(UNTRACKED)
  personalRating          Float?
  computedPersonalScore   Float?
  personalScoreConfidence Float       @default(0)
  pairwiseScore           Float       @default(1000)
  comparisonCount         Int         @default(0)
  isFavorite              Boolean     @default(false)
  isArchived              Boolean     @default(false)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId])
  @@index([mediaId])
  @@index([userId, status])
  @@index([userId, pairwiseScore])
  @@index([userId, computedPersonalScore])
}

model ExternalRating {
  id           String               @id @default(cuid())
  mediaId      String
  source       ExternalRatingSource
  score        Float
  scale        Float                @default(100)
  sourceUrl    String?
  metadataJson String?
  fetchedAt    DateTime             @default(now())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  media        MediaItem            @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, source])
  @@index([source])
  @@index([score])
}

model ReleaseCandidate {
  id                  String                 @id @default(cuid())
  mediaType           MediaType
  title               String
  normalizedTitle     String
  externalSource      ExternalReleaseSource
  externalId          String
  externalUrl         String?
  description         String?
  posterUrl           String?
  releaseDate         DateTime?
  genresJson          String?
  tagsJson            String?
  companiesJson       String?
  platformsJson       String?
  metadataJson        String?
  publicInterestScore Float                  @default(0)
  localAffinityScore  Float                  @default(0)
  indieSignalScore    Float                  @default(0)
  qualityScore        Float                  @default(0)
  confidenceScore     Float                  @default(0)
  finalScore          Float                  @default(0)
  reasonJson          String?
  status              ReleaseCandidateStatus @default(PENDING)
  fetchedAt           DateTime               @default(now())
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([externalSource, externalId])
  @@index([mediaType])
  @@index([status])
  @@index([finalScore])
  @@index([normalizedTitle, mediaType])
}

model Genre {
  id    String       @id @default(cuid())
  name  String       @unique
  media MediaGenre[]
}

model MediaGenre {
  mediaId String
  genreId String
  media   MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  genre   Genre     @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([mediaId, genreId])
}

model Tag {
  id             String      @id @default(cuid())
  name           String
  normalizedName String      @unique
  status         TagStatus   @default(APPROVED)
  category       TagCategory @default(THEME)
  discoverable   Boolean     @default(false)
  mediaTypesJson String?
  countryCode    String?
  createdById    String?
  approvedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  media          MediaTag[]

  @@unique([name])
  @@index([status])
  @@index([category])
  @@index([discoverable])
  @@index([countryCode])
}

model MediaTag {
  mediaId String
  tagId   String
  media   MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag     Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
}

model Contributor {
  id             String          @id @default(cuid())
  name           String
  normalizedName String
  kind           ContributorKind
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  credits        MediaCredit[]

  @@unique([normalizedName, kind])
  @@index([name])
  @@index([kind])
}

model MediaCredit {
  mediaId       String
  contributorId String
  role          CreditRole
  order         Int        @default(0)
  source        String?
  sourceId      String?
  media         MediaItem  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  contributor   Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@id([mediaId, contributorId, role])
  @@index([role])
  @@index([contributorId])
}

model PairwiseComparison {
  id                    String             @id @default(cuid())
  userId                String
  winnerId              String
  loserId               String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  winner                MediaItem          @relation("Winner", fields: [winnerId], references: [id])
  loser                 MediaItem          @relation("Loser", fields: [loserId], references: [id])
  context               ComparisonContext?
  weight                Float              @default(1)
  notes                 String?
  winnerScoreBefore     Float?
  winnerScoreAfter      Float?
  loserScoreBefore      Float?
  loserScoreAfter       Float?
  winnerDelta           Float?
  loserDelta            Float?
  expectedWinnerWinProb Float?
  createdAt             DateTime           @default(now())

  @@index([userId])
  @@index([winnerId])
  @@index([loserId])
  @@index([createdAt])
}

model CustomList {
  id            String        @id @default(cuid())
  userId        String
  name          String
  kind          ListKind
  /// Reused as the intro/lede for COLLECTION lists (plain text, line breaks preserved).
  description   String?
  /// Short dek/eyebrow shown under the title on COLLECTION lists.
  subtitle      String?
  /// Optional cover image (external URL, same shape as MediaItem.posterUrl).
  coverUrl      String?
  /// Draft vs. live to signed-in users (COLLECTION lists).
  isPublished   Boolean       @default(false)
  /// "YYYY-MM"; set on at most one COLLECTION per month (the featured monthly theme).
  featuredMonth String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         ListItem[]
  sections      ListSection[]

  @@unique([userId, name])
  @@unique([featuredMonth])
  @@index([userId])
  @@index([kind])
  @@index([isPublished])
}

/// A sub-category within a COLLECTION list, grouping its items under a heading.
model ListSection {
  id          String     @id @default(cuid())
  listId      String
  title       String
  description String?
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  list        CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)
  items       ListItem[]

  @@index([listId])
}

model ListItem {
  id        String       @id @default(cuid())
  listId    String
  sectionId String?
  mediaId   String
  rank      Int?
  note      String?
  createdAt DateTime     @default(now())
  list      CustomList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  section   ListSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  media     MediaItem    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([listId, mediaId])
  @@index([sectionId])
}

/// The owning account. Auth is handled by Auth.js (NextAuth v5) with the Prisma
/// adapter: `email`, `emailVerified`, `name`, and `image` follow the adapter's
/// expected shape, while `displayName` and `avatarColor` are Medialy-specific
/// presentation. Use `getCurrentUser()` from `lib/user.ts` as the single source
/// of truth for "who is acting".
model User {
  id            String    @id @default(cuid())
  displayName   String
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  avatarColor   String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  userMedia     UserMedia[]
  comparisons   PairwiseComparison[]
  notes         Note[]
  customLists   CustomList[]
  editSuggestions       MediaEditSuggestion[] @relation("EditSuggestionAuthor")
  reviewedSuggestions   MediaEditSuggestion[] @relation("EditSuggestionReviewer")
  following     UserFollow[]          @relation("Follower")
  followers     UserFollow[]          @relation("Following")
}

/// One-way follow between two users. `followerId` follows `followingId`. Public
/// taste data (ratings + COMPLETED items) is visible without a follow; the
/// follow drives the `/friends` page list, the activity feed, and the
/// `friendAffinity` signal in `medialyMatch`.
model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

/// A non-admin's proposed edit (or addition) to a `MediaItem`, awaiting admin
/// review. `beforeJson` snapshots the item state at submission time so admins
/// can see what changed even if the underlying item has since been touched;
/// `afterJson` holds the serialized `MediaFormInput` payload. `mediaId` is
/// nullable so the same queue can hold proposed new items.
model MediaEditSuggestion {
  id           String                  @id @default(cuid())
  mediaId      String?
  userId       String
  beforeJson   String?
  afterJson    String
  status       EditSuggestionStatus    @default(PENDING)
  note         String?
  createdAt    DateTime                @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?

  media    MediaItem? @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user     User       @relation("EditSuggestionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?      @relation("EditSuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([mediaId])
  @@index([userId])
  @@index([createdAt])
}

/// Auth.js Prisma adapter — third-party identity (Google OAuth) linked to a User.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Auth.js Prisma adapter — database-backed session.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Auth.js Prisma adapter — email verification tokens (unused with Google-only,
/// but the adapter expects this table to exist).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Note {
  id        String    @id @default(cuid())
  userId    String
  mediaId   String
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mediaId])
}

model ImportJob {
  id            String           @id @default(cuid())
  sourceType    ImportSourceType
  fileName      String?
  status        ImportStatus
  importedCount Int              @default(0)
  skippedCount  Int              @default(0)
  errorJson     String?
  createdAt     DateTime         @default(now())
}

enum MediaType {
  MOVIE
  TV_SHOW
  VIDEO_GAME
  BOOK
  BOARD_GAME
  MUSIC
  MUSICAL
}

enum MediaStatus {
  UNTRACKED
  WATCHLIST
  BACKLOG
  IN_PROGRESS
  COMPLETED
  DROPPED
  PAUSED
  NOT_INTERESTED
}

enum RelationKind {
  FOLLOWS
  SPINOFF_OF
  REMAKE_OF
  ADAPTED_FROM
}

enum ReleaseKind {
  REMASTER
  PORT
  RERELEASE
  DLC
}

enum ComparisonContext {
  OVERALL
  REWATCHABILITY
  STORY
  GAMEPLAY
  VISUALS
  MUSIC
  COMFORT
  SOCIAL
}

enum ListKind {
  WATCHLIST
  FAVORITES
  TOP_LIST
  CUSTOM
  COLLECTION
}

enum ExternalReleaseSource {
  TMDB
  TVMAZE
  IGDB
  RAWG
}

enum ExternalRatingSource {
  METACRITIC
  ROTTEN_TOMATOES_CRITICS
  ROTTEN_TOMATOES_AUDIENCE
  IMDB
  OPENCRITIC
  LETTERBOXD
  TMDB
  GOODREADS
  STORYGRAPH
  BGG
  STEAM
  ANILIST
  MYANIMELIST
  RAWG_USER
}

enum ReleaseCandidateStatus {
  PENDING
  APPROVED
  REJECTED
  IMPORTED
  IGNORED
}

enum ImportSourceType {
  JSON
  CSV
  XLSX
}

enum ImportStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum EditSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TagStatus {
  APPROVED
  PENDING
  REJECTED
}

enum TagCategory {
  SUBGENRE
  COUNTRY
  THEME
  MECHANIC
  MOOD
  FORMAT
}

enum ContributorKind {
  PERSON
  COMPANY
}

enum CreditRole {
  DIRECTOR
  CREATOR
  DEVELOPER
  PUBLISHER
  ACTOR
}
